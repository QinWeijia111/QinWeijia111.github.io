---
import '../styles/global.css';
import { profile } from '../data/profile';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = `${profile.name} · Agent Systems`,
  description = profile.description,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/images/og.png', Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f5f0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="Qin Weijia · Agent Systems" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Qin Weijia — Building reliable Agent systems for real-world software."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (
          saved === 'dark' ||
          (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)
        )
          document.documentElement.dataset.theme = 'dark';
      } catch {
        /* System default remains available via CSS. */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳至主要内容
    </a>
    <header class="site-header wrap flex items-center justify-between gap-4">
      <a class="wordmark" href="/" aria-label="QW. 秦维嘉 首页">
        QW<span>.</span>
        <span class="wordmark-name">秦维嘉</span>
      </a>
      <nav aria-label="主导航" class="flex items-center gap-5">
        <a href="/#projects">项目</a>
        <a href="/#about" class="nav-about">
          关于
        </a>
        <a href="/#contact">联系</a>
        <button
          class="theme-toggle"
          type="button"
          aria-label="切换深色与浅色主题"
          hidden
        >
          <span aria-hidden="true">◐</span>
        </button>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <p>
        © {new Date().getFullYear()} {profile.romanizedName}
        <span class="footer-dot"> · </span>
        <span>认真构建，持续迭代。</span>
      </p>
      <a href="#main">返回顶部 ↑</a>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      if (toggle) {
        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          const root = document.documentElement;
          const dark =
            root.dataset.theme === 'dark' ||
            (!root.dataset.theme &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          const theme = dark ? 'light' : 'dark';
          root.dataset.theme = theme;
          try {
            localStorage.setItem('theme', theme);
          } catch {
            /* Still works without storage. */
          }
        });
      }
    </script>
  </body>
</html>
