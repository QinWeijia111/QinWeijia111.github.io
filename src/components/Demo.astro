---
import type { CollectionEntry } from 'astro:content';
interface Props {
  project: CollectionEntry<'projects'>;
}
const {
  project: { data },
} = Astro.props;
---

<section class="detail-section" id="demo" aria-labelledby="demo-heading">
  <p class="eyebrow">查看实际成果</p>
  <h2 id="demo-heading">
    {data.demo.status === 'not-applicable' ? '阅读完整研究' : '项目演示'}
  </h2>
  {data.demo.status === 'approved' && data.demo.src ? (
    <>
      <p class="muted">
        {data.demo.note} 视频无音轨，可通过画面字幕与中文阶段说明观看。
      </p>
      {data.demo.stages && (
        <div class="demo-guide">
          <h3>演示中可以看到</h3>
          <ol>
            {data.demo.stages.map((stage, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                {stage}
              </li>
            ))}
          </ol>
        </div>
      )}
      <video
        controls
        preload="metadata"
        poster={data.demo.poster ?? data.poster}
        width="1280"
        height="720"
        aria-label={`${data.title} 演示视频`}
      >
        <source src={data.demo.src} type="video/mp4" />
        <track
          kind="captions"
          src={data.demo.captions}
          srclang="zh"
          label="中文"
          default
        />
        你的浏览器不支持视频播放。
      </video>
    </>
  ) : (
    <div class="demo-preview">
      <img
        src={data.poster}
        alt={data.posterAlt}
        loading="lazy"
        width="960"
        height="600"
      />
      <div>
        <span class="status-tag">
          {data.demo.status === 'not-applicable'
            ? '公开学习站'
            : '视频 · 待人工审核'}
        </span>
        <p>{data.demo.note}</p>
        {data.demo.status === 'not-applicable' && data.links[0] && (
          <a class="text-link" href={data.links[0].url}>
            阅读 M01–M06 ↗
          </a>
        )}
      </div>
    </div>
  )}
</section>
