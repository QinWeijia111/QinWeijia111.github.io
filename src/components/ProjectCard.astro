---
import type { CollectionEntry } from 'astro:content';
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { data, id } = project;
---

<article class="project-card">
  <a
    class="project-art"
    href={`/projects/${id}/`}
    aria-label={`公开概念示意：查看 ${data.title} 项目`}
  >
    <img
      src={data.poster}
      alt={data.posterAlt}
      width="960"
      height="600"
      loading="lazy"
    />
    <span class="art-caption">
      公开概念示意 <span aria-hidden="true">↗</span>
    </span>
  </a>
  <div class="project-copy">
    <p class="eyebrow">
      0{data.order} / {data.category}
    </p>
    <h3>
      <a href={`/projects/${id}/`}>
        {data.title}
        <span aria-hidden="true">↗</span>
      </a>
    </h3>
    <p class="project-subtitle">{data.subtitle}</p>
    <p>{data.summary}</p>
    <p class="ownership">
      <span aria-hidden="true">↳</span> {data.ownership}
    </p>
    <ul class="project-highlights">
      {data.highlights.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    <a class="text-link" href={`/projects/${id}/`}>
      了解项目 <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
