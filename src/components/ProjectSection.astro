---
import type { CollectionEntry } from 'astro:content';
interface Props {
  section: CollectionEntry<'projects'>['data']['detailSections'][number];
  id: string;
}
const { section, id } = Astro.props;
---

<section class="detail-section" aria-labelledby={id}>
  <h2 id={id}>{section.heading}</h2>
  {section.description && <p class="reading-width">{section.description}</p>}
  <ol
    class:list={[
      'narrative-items',
      section.layout === 'flow' ? 'narrative-flow' : 'narrative-cards',
    ]}
  >
    {section.items.map((item, index) => (
      <li>
        <span class="item-number">
          {item.label ?? String(index + 1).padStart(2, '0')}
        </span>
        <h3>{item.title}</h3>
        {item.description && <p>{item.description}</p>}
        {item.url && (
          <a
            class="text-link"
            href={item.url}
            aria-label={`${item.label ?? item.title} · 阅读完整章节`}
          >
            阅读完整章节 <span aria-hidden="true">↗</span>
          </a>
        )}
      </li>
    ))}
  </ol>
</section>
