---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Demo from '../../components/Demo.astro';
import ProjectSection from '../../components/ProjectSection.astro';
export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
      previous: projects[index - 1],
      next: projects[index + 1],
    },
  }));
}
const { project, previous, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const related = data.crossProject
  ? await getEntry(data.crossProject.project)
  : undefined;
---

<Layout title={`${data.title} · 秦维嘉`} description={data.summary}>
  <article class="project-detail wrap">
    <a class="back-link" href="/#projects">
      ← 全部项目
    </a>
    <header class="detail-hero">
      <p class="eyebrow">{data.category}</p>
      <h1>{data.title}</h1>
      <p class="detail-subtitle">{data.subtitle}</p>
      <p class="lead">{data.summary}</p>
      <div class="detail-meta">
        <span>{data.status}</span>
        <span>{data.ownership}</span>
      </div>
    </header>
    <div class="detail-content">
      <Content />
    </div>
    {data.detailSections.map((section, index) => (
      <ProjectSection section={section} id={`narrative-${index}`} />
    ))}
    {data.architecture && (
      <section class="detail-section" aria-labelledby="architecture-title">
        <p class="eyebrow">高层概览</p>
        <h2 id="architecture-title">架构概览</h2>
        <ol class="architecture-flow">
          {data.architecture.map((step, i) => (
            <li>
              <span>0{i + 1}</span>
              {step}
            </li>
          ))}
        </ol>
        {data.architectureNote && <p class="muted">{data.architectureNote}</p>}
      </section>
    )}
    {data.architectureDiagrams.length > 0 && (
      <section
        class="detail-section"
        aria-labelledby="architecture-diagrams-title"
      >
        <p class="eyebrow">系统设计</p>
        <h2 id="architecture-diagrams-title">PiRevit 整体架构</h2>
        <div class="architecture-diagram-list">
          {data.architectureDiagrams.map((diagram) => (
            <figure class="architecture-diagram-card">
              <a href={diagram.src} target="_blank" rel="noreferrer">
                <img
                  src={diagram.src}
                  alt={diagram.alt}
                  loading="lazy"
                  decoding="async"
                  width="1536"
                  height="960"
                />
              </a>
              <figcaption>
                <strong>{diagram.title}</strong>
                <p>{diagram.description}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
    <Demo project={project} />
    <section class="detail-section" aria-labelledby="results-title">
      <p class="eyebrow">结果与适用范围</p>
      <h2 id="results-title">关键结果</h2>
      {data.metrics.length > 0 && (
        <dl class="metrics-grid">
          {data.metrics.map((metric) => (
            <div>
              <dt>{metric.label}</dt>
              <dd>{metric.value}</dd>
              <dd class="metric-context">{metric.context}</dd>
            </div>
          ))}
        </dl>
      )}
      <p class="result-note">{data.resultNote}</p>
    </section>
    {data.evolution && (
      <ProjectSection section={data.evolution} id="evolution-title" />
    )}
    {data.crossProject && related && (
      <section
        class="detail-section cross-project reading-width"
        aria-labelledby="cross-project-title"
      >
        <p class="eyebrow">同一条系统演进路线</p>
        <h2 id="cross-project-title">{data.crossProject.heading}</h2>
        <p>{data.crossProject.description}</p>
        <a class="text-link" href={`/projects/${related.id}/`}>
          查看 {related.data.title} →
        </a>
      </section>
    )}
    <section class="detail-section reading-width" aria-labelledby="role-title">
      <h2 id="role-title">我的角色</h2>
      <p>{data.myRole}</p>
    </section>
    <section class="detail-section" aria-labelledby="tech-title">
      <h2 id="tech-title">主要技术</h2>
      <ul class="technology-list">
        {data.technologies.map((tech) => (
          <li>{tech}</li>
        ))}
      </ul>
    </section>
    <section class="detail-section" aria-labelledby="links-title">
      <h2 id="links-title">相关链接</h2>
      {data.links.length ? (
        <div class="project-links">
          {data.links.map((link) => (
            <a class="text-link" href={link.url}>
              {link.label} ↗
            </a>
          ))}
        </div>
      ) : (
        <p>
          项目代码与工程资产不公开。欢迎
          <a class="text-link" href="/#contact">
            联系交流 ↗
          </a>
          公开成果。
        </p>
      )}
    </section>
    <nav class="project-pagination" aria-label="继续了解其他项目">
      {previous ? (
        <a href={`/projects/${previous.id}/`}>
          <span>← 上一个项目</span>
          <strong>{previous.data.title}</strong>
        </a>
      ) : (
        <a href="/#projects">
          <span>← 返回</span>
          <strong>代表项目</strong>
        </a>
      )}
      {next ? (
        <a href={`/projects/${next.id}/`}>
          <span>下一个项目 →</span>
          <strong>{next.data.title}</strong>
        </a>
      ) : (
        <a href="/#contact">
          <span>继续交流 →</span>
          <strong>联系我</strong>
        </a>
      )}
    </nav>
  </article>
</Layout>

<style>
  .architecture-diagram-list {
    display: grid;
    gap: 34px;
  }

  .architecture-diagram-card {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }

  .architecture-diagram-card a {
    display: block;
    background: #f5f5f0;
  }

  .architecture-diagram-card img {
    width: 100%;
    height: auto;
  }

  .architecture-diagram-card figcaption {
    padding: 24px 26px 26px;
    border-top: 1px solid var(--line);
  }

  .architecture-diagram-card strong {
    display: block;
    margin-bottom: 10px;
    font-size: 18px;
    color: var(--text);
  }

  .architecture-diagram-card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.8;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .architecture-diagram-card figcaption {
      padding: 20px;
    }

    .architecture-diagram-card strong {
      font-size: 16px;
    }

    .architecture-diagram-card p {
      font-size: 14px;
    }
  }
</style>
